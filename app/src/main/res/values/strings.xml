<resources>
    <string name="app_name">专注锁机</string>
    <string name="app_tagline">掌控专注，减少分心</string>

    <!-- 无障碍服务 -->
    <string name="accessibility_service_description">专注锁机使用无障碍服务检测专注期间的主页、返回和最近任务操作，并在检测到离开受限界面的操作时立即执行锁定。本服务不会读取应用中的个人数据、文本或内容。</string>
    <string name="accessibility_service_label">专注锁机拦截服务</string>

    <!-- 设备管理 -->
    <string name="device_admin_description">专注锁机需要设备管理权限，以便在专注期间检测到受限制的导航操作时锁定屏幕。这是实现强制专注锁定的核心功能。</string>

    <!-- 权限 -->
    <string name="perm_overlay_title">显示在其他应用上层</string>
    <string name="perm_overlay_desc">用于在专注期间将全屏锁定计时界面显示在其他应用上方。</string>
    <string name="perm_accessibility_title">无障碍服务</string>
    <string name="perm_accessibility_desc">用于检测主页、返回和最近任务操作，并立即执行锁定。</string>
    <string name="perm_device_admin_title">设备管理权限（必需）</string>
    <string name="perm_device_admin_desc">检测到受限制的操作时需要此权限来锁定屏幕。缺少此权限将无法正常执行锁定。</string>
    <string name="perm_battery_title">忽略电池优化</string>
    <string name="perm_battery_desc">帮助专注计时服务在后台稳定运行，降低被系统终止的概率。</string>
    <string name="perm_notifications_title">通知权限</string>
